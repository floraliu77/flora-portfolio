---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={`${d.company} – ${d.title}`} description={d.summary} current="Portfolio" image={d.cover}>
  <article class="cs">
    <header class="cs-hero">
      <p class="eyebrow" style="margin: 0">{d.company}</p>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}
      {d.tags.length > 0 && <ul class="chips" aria-label="Tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      {d.links.length > 0 && (
        <div style="display: flex; flex-wrap: wrap; gap: .85rem; margin-top: .5rem">
          {d.links.map((l) => <a class="btn" href={l.href} rel="noopener">{l.label}</a>)}
        </div>
      )}
    </header>

    <div class="cs-cover">
      <Cover cover={d.cover} coverAlt={d.coverAlt} coverScreens={d.coverScreens} eager />
    </div>

    {d.overview.length > 0 && (
      <dl class="cs-meta">
        {d.overview.map((o) => <div><dt>{o.label}</dt><dd>{o.value}</dd></div>)}
      </dl>
    )}

    {d.impact.length > 0 && (
      <section class="impact" aria-label="Impact">
        {d.impact.map((m) => <div><strong>{m.stat}</strong><span>{m.label}</span></div>)}
      </section>
    )}

    <div class="prose"><Content /></div>

    {next && next.id !== entry.id && (
      <nav class="cs-next" aria-label="More work">
        <a class="text-link" href="/portfolio">← All work</a>
        <a class="text-link" href={`/work/${next.id}`}>Next: {next.data.title} →</a>
      </nav>
    )}
  </article>

  <script>
    // Turn each .rounds block into a one-at-a-time stepper (all rounds stay visible without JS)
    document.querySelectorAll<HTMLElement>('.rounds').forEach((box, b) => {
      const rounds = [...box.querySelectorAll<HTMLElement>(':scope > .round')];
      if (rounds.length < 2) return;
      box.classList.add('is-enhanced');
      const tabs = document.createElement('div');
      tabs.className = 'rounds-tabs';
      tabs.setAttribute('role', 'tablist');
      tabs.setAttribute('aria-label', box.getAttribute('aria-label') || 'Design rounds');
      const nav = document.createElement('div');
      nav.className = 'rounds-nav';
      const prev = Object.assign(document.createElement('button'), { type: 'button', textContent: '← Previous' });
      const next = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Next →' });
      nav.append(prev, next);
      const buttons = rounds.map((r, i) => {
        const id = `round-${b}-${i}`;
        r.id = id;
        r.setAttribute('role', 'tabpanel');
        const btn = Object.assign(document.createElement('button'), { type: 'button', textContent: r.dataset.label || `Round ${i + 1}` });
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-controls', id);
        btn.addEventListener('click', () => show(i));
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + rounds.length) % rounds.length;
            show(j); buttons[j].focus();
          }
        });
        tabs.append(btn);
        return btn;
      });
      let current = 0;
      function show(i: number) {
        current = i;
        rounds.forEach((r, k) => { r.hidden = k !== i; });
        buttons.forEach((btn, k) => { btn.setAttribute('aria-selected', String(k === i)); btn.tabIndex = k === i ? 0 : -1; });
        prev.disabled = i === 0;
        next.disabled = i === rounds.length - 1;
      }
      prev.addEventListener('click', () => show(Math.max(0, current - 1)));
      next.addEventListener('click', () => show(Math.min(rounds.length - 1, current + 1)));
      box.prepend(tabs);
      box.append(nav);
      show(0);
    });
  </script>
</Base>
