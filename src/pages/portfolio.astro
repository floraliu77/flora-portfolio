---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Portfolio" current="Portfolio" description="UX and product design case studies by Flora Liu.">
  <section class="work portfolio" aria-labelledby="portfolio-title">
    <div class="work-inner">
      <div style="display: flex; flex-direction: column; gap: .9rem; max-width: 40rem">
        <h1 id="portfolio-title" class="section-title">Portfolio</h1>
        <p style="margin: 0; font-size: 1.2rem; line-height: 1.55">Product design from four and a half years at a SaaS startup, and new HCI work from Carnegie Mellon.</p>
      </div>
      {work.map((entry, i) => <CaseCard entry={entry} flip={i % 2 === 1} />)}
    </div>
  </section>
</Base>
