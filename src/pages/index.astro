---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import '../styles/hero.css';
import '../styles/blob.css';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base bareHeader theme="light">
  <div class="hero">
    <!-- Small sketch shapes on the text side (hidden on phones) -->
    <img class="planet sketch-star hero-deco p3" src="/art/sketch/sparkle.svg" alt="" style="left: 3%; top: 20%; width: 1.9rem" />
    <img class="planet sketch-star hero-deco p2" src="/art/sketch/circle-dots.svg" alt="" style="left: 3.5%; top: 58%; width: 2.6rem" />
    <img class="planet sketch-star hero-deco p4" src="/art/sketch/triangle-tone.svg" alt="" style="left: 6%; top: 86%; width: 2.3rem" />
    <img class="planet sketch-star hero-deco p1" src="/art/sketch/star-tone.svg" alt="" style="left: 41%; top: 13%; width: 2.4rem" />
    <img class="planet sketch-star hero-deco p3" src="/art/sketch/square-tone.svg" alt="" style="left: 31%; top: 85%; width: 2rem" />
    <div class="hero-text">
      <Nav current="Home" />
      <div class="hero-body">
        <p class="t-sub" style="margin: 0; line-height: 1.35">Looking for a product designer who can bring your vision to life?</p>
        <h1 style="margin: 0; font-weight: 400; line-height: 1.02; letter-spacing: -0.01em">
          <span class="t-h1" style="display: block; color: var(--mint)">Hi, I’m <span style="color: var(--coral)">Flora</span></span>
          <span class="t-h2" style="display: block; margin-top: .12em">Let’s work together</span>
        </h1>
        <ul class="chips" aria-label="Background" style="font-size: .82rem">
          <li>CMU MHCI</li><li>RISD BFA</li><li>B2B SaaS</li>
        </ul>
        <p class="t-body" style="margin: .5rem 0 0; line-height: 1.55; max-width: 30rem">I utilize UX design, creative storytelling, and HCI research to bring betterment to the world</p>
        <div class="hero-ctas" style="display: flex; flex-wrap: wrap; gap: .85rem; margin-top: .5rem">
          <img class="planet sketch-star hero-deco-m p1" src="/art/sketch/star-tone.svg" alt="" style="right: 8%; bottom: .2rem; width: 2.6rem" />
          <img class="planet sketch-star hero-deco-m p3" src="/art/sketch/sparkle.svg" alt="" style="right: 30%; bottom: 1.4rem; width: 1.6rem" />
          <a class="btn" href={site.resume} download="Flora-Liu-Resume.pdf">Download CV</a>
          <a class="btn" href="/portfolio">View Portfolio</a>
          <a class="btn" href="/about">About Me</a>
        </div>
      </div>
      <a class="scroll-cue" href="#work" aria-label="Scroll down to selected work"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M5.5 12.5L12 19l6.5-6.5"></path></svg></a>
    </div>
    <div class="hero-art">
      <div class="art-stage">
        <img class="planet sketch-star p1" src="/art/sketch/star-tone.svg" alt="" style="left: 3%; top: 8%; width: 11%" />
        <img class="planet sketch-star p3" src="/art/sketch/square-tone.svg" alt="" style="left: 0%; top: 45%; width: 7.5%" />
        <img class="planet sketch-star p2" src="/art/sketch/circle-dots.svg" alt="" style="left: 8%; top: 74%; width: 9.5%" />
        <img class="planet sketch-star p4" src="/art/sketch/triangle-dots.svg" alt="" style="left: 28%; top: 90%; width: 6%" />
        <img class="planet sketch-star p3" src="/art/sketch/sparkle.svg" alt="" style="left: 90%; top: 85%; width: 5.5%" />
        <img class="layer blob" src="/art/city.svg" alt="Futuristic city that turns from a pencil sketch on the left into a polished rendering on the right" />
        <div class="flora layer">
          <img class="layer" src="/art/flora-back.svg" alt="" />
          <img class="layer flora-legs" src="/art/flora-legs.svg?v=skin" alt="" />
          <img class="layer" src="/art/flora-front.svg?v=skin" alt="Flora riding a giant pen" />
        </div>
      </div>
    </div>
  </div>

  <section id="work" class="work" aria-labelledby="work-title">
    <img class="planet sketch-star p2" src="/art/sketch/circle-line.svg" alt="" style="right: 4%; top: 4rem; width: 6rem" />
    <img class="planet sketch-star p1" src="/art/sketch/star-hatch.svg" alt="" style="left: 2%; top: 40%; width: 5.5rem" />
    <img class="planet sketch-star p3" src="/art/sketch/triangle-tone.svg" alt="" style="right: 5%; top: 70%; width: 4.75rem" />
    <img class="planet sketch-star p4" src="/art/sketch/sparkle.svg" alt="" style="left: 46%; bottom: 3rem; width: 2.75rem" />
    <div class="work-inner">
      <div style="display: flex; flex-direction: column; gap: .9rem; max-width: 40rem">
        <h2 id="work-title" class="section-title">Selected work</h2>
        <p style="margin: 0; font-size: 1.2rem; line-height: 1.55">Selected design work from my professional career at a SaaS startup and my coursework at Carnegie Mellon.</p>
      </div>
      {work.map((entry, i) => <CaseCard entry={entry} flip={i % 2 === 1} />)}
    </div>
  </section>

  <script>
    const cue = document.querySelector('.scroll-cue');
    const onScroll = () => cue?.classList.toggle('is-hidden', window.scrollY > 80);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
