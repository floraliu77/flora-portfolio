---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import '../styles/hero.css';
import '../styles/blob.css';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base bareHeader>
  <div class="hero">
    <div class="hero-text">
      <Nav current="Home" />
      <div class="hero-body">
        <p class="t-sub" style="margin: 0; line-height: 1.35">Looking for a product designer who can bring your vision to life?</p>
        <h1 style="margin: 0; font-weight: 400; line-height: 1.02; letter-spacing: -0.01em">
          <span class="t-h1" style="display: block; color: var(--mint)">Hi, I’m <span style="color: var(--coral)">Flora</span></span>
          <span class="t-h2" style="display: block; margin-top: .12em">Let’s work together</span>
        </h1>
        <ul class="chips" aria-label="Background" style="font-size: .82rem">
          <li>RISD BFA</li><li>CMU MHCI</li><li>Startup Experience</li>
        </ul>
        <p class="t-body" style="margin: .5rem 0 0; line-height: 1.55; max-width: 30rem">I utilize UX design, creative storytelling, and HCI research to bring betterment to the world</p>
        <div style="display: flex; flex-wrap: wrap; gap: .85rem; margin-top: .5rem">
          <a class="btn" href={site.resume} download="Flora-Liu-Resume.pdf">Download CV</a>
          <a class="btn" href="/portfolio">View Portfolio</a>
          <a class="btn" href="/about">About Me</a>
        </div>
      </div>
      <a class="scroll-cue" href="#work" aria-label="Scroll down to selected work"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M5.5 12.5L12 19l6.5-6.5"></path></svg></a>
    </div>
    <div class="hero-art">
      <div class="art-stage">
        <img class="planet p1" src="/art/planet-1.svg" alt="" style="left: 4.13%; top: 9.67%; width: 14.88%" />
        <img class="planet p2" src="/art/planet-2.svg" alt="" style="left: 9.5%; top: 76.28%; width: 10.95%" />
        <img class="planet p3" src="/art/planet-3.svg" alt="" style="left: 91.63%; top: 85.41%; width: 4.34%" />
        <img class="planet p4" src="/art/planet-4.svg" alt="" style="left: 28.51%; top: 92.66%; width: 2.07%" />
        <img class="layer blob" src="/art/city.svg" alt="Futuristic city that turns from a pencil sketch on the left into a polished rendering on the right" />
        <svg class="ink-layer" viewBox="760 0 968 1117" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible">
          <path class="ink" d="M1436 676c12 8 22 -6 34 2s22 8 34 0s22 -8 34 0s20 6 32 0"></path>
          <path class="spark s1" d="M1452 640l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"></path>
          <path class="spark s2" d="M1478 662l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"></path>
          <path class="spark s3" d="M1418 650l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"></path>
        </svg>
        <div class="flora layer">
          <img class="layer" src="/art/flora-back.svg" alt="" />
          <img class="layer flora-legs" src="/art/flora-legs.svg" alt="" />
          <img class="layer" src="/art/flora-front.svg" alt="Flora riding a giant pen" />
        </div>
      </div>
    </div>
  </div>

  <section id="work" class="work" aria-labelledby="work-title">
    <img class="planet p2" src="/art/planet-2.svg" alt="" style="right: -4rem; top: 3rem; width: 13rem" />
    <img class="planet p1" src="/art/planet-1.svg" alt="" style="left: 2%; top: 40.5%; width: 6.5rem" />
    <img class="planet p3" src="/art/planet-3.svg" alt="" style="right: 5%; top: 70%; width: 3rem" />
    <img class="planet p4" src="/art/planet-4.svg" alt="" style="left: 46%; bottom: 3rem; width: 1.5rem" />
    <div class="work-inner">
      <div style="display: flex; flex-direction: column; gap: .9rem; max-width: 40rem">
        <h2 id="work-title" class="section-title">Selected work</h2>
        <p style="margin: 0; font-size: 1.2rem; line-height: 1.55">Product design from four and a half years at a SaaS startup, and new HCI work from Carnegie Mellon.</p>
      </div>
      {work.map((entry, i) => <CaseCard entry={entry} flip={i % 2 === 1} />)}
    </div>
  </section>

  <script>
    const cue = document.querySelector('.scroll-cue');
    const onScroll = () => cue?.classList.toggle('is-hidden', window.scrollY > 80);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
